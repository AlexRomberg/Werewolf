{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": ["/favicon/**", "/index.html", "/*.css", "/*.js"]
      }
    },
    {
      "name": "images",
      "installMode": "prefetch",
      "updateMode": "prefetch",
      "resources": {
        "files": ["/img/**"]
      }
    }
  ]
}
